{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeDeck",
  "version": "0.1.0",
  "identifier": "com.vibedeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "VibeDeck",
      "width": 1280,
      "height": 820,
      "minWidth": 960,
      "minHeight": 620,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
