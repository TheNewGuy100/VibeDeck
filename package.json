{
  "name": "vibedeck",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "set \"PATH=%USERPROFILE%\\.cargo\\bin;%PATH%\" && tauri",
    "tauri:build": "npm run tauri -- build",
    "tauri:build:msi": "npm run tauri -- build --bundles msi",
    "tauri:debug": "node scripts/tauri-debug.mjs",
    "session:debug": "node scripts/session-debug.mjs",
    "lab:test": "node --test scripts/sabr-trace/sabr-trace.test.mjs scripts/sabr-trace/validate-n.test.mjs scripts/sabr-trace/pot-observe.test.mjs scripts/sabr-trace/session-observe.test.mjs scripts/cdp-lab/cdp-lab.test.mjs",
    "youtube:playlist-probe:debug": "node scripts/youtube-playlist-probe-debug.mjs",
    "youtube:healthcheck": "powershell -ExecutionPolicy Bypass -NoProfile -File scripts/youtube-healthcheck.ps1"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "three": "^0.186.0",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.5",
    "@types/node": "^24.5.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.7"
  }
}
